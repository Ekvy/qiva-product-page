# Vorlage für .env — diese Datei hier ist NUR die Vorlage und enthält keine
# echten Werte. Kopieren mit:  cp .env.example .env
#
# Die .env selbst ist in .gitignore ausgeschlossen und darf niemals committet
# werden. Falls doch einmal passiert: Keys sofort in Brevo bzw. Cloudflare
# widerrufen und neu erzeugen — ein einmal gepushter Key gilt als verbrannt.

# --- Brevo -----------------------------------------------------------------
# Brevo → Settings → SMTP & API → API Keys → Generate a new API key
# Wird genau einmal angezeigt. Landet später als Cloudflare-Secret im Worker,
# nicht im Seiten-Code.
BREVO_API_KEY=

# --- Cloudflare ------------------------------------------------------------
# dash.cloudflare.com → Profilmenü oben rechts → API Tokens → Create Token
# → Vorlage "Edit Cloudflare Workers" verwenden.
# Benötigte Rechte: Account → Workers Scripts → Edit
CLOUDFLARE_API_TOKEN=

# dash.cloudflare.com → Workers & Pages → rechte Spalte "Account Details"
# → Account ID
CLOUDFLARE_ACCOUNT_ID=
